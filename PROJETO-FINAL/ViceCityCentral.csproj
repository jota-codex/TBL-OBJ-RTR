<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ViceCityCentral</RootNamespace>
    <AssemblyName>ViceCityCentral</AssemblyName>
    <ApplicationIcon>Assets\Icons\app.ico</ApplicationIcon>
    <Product>Vice City Central</Product>
    <Description>GTA VI Management System - Projeto Final de POO I</Description>
    <Version>1.0.0</Version>
    <!-- Permite compilar (dotnet build) também fora do Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Executa também em máquinas que tenham apenas um runtime .NET mais novo (9, 10...) -->
    <RollForward>LatestMajor</RollForward>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <!-- Imagens, ícones e o script do banco são copiados para a pasta de saída -->
  <ItemGroup>
    <None Update="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Database\vice_city.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="docs\**" />
    <None Remove="docs\**" />
  </ItemGroup>

</Project>
